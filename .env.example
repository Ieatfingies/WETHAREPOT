# ==============================================================================
# WETHAREPOT — Environment Variables Configuration Template
# ==============================================================================

# --- Backend Configuration ---
HOST=0.0.0.0
PORT=8000

# Persistence: Leave blank for zero-configuration local SQLite (data/wetharepot.db)
# Or provide a PostgreSQL / Supabase connection string:
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres
DATABASE_URL=

# Directory where compressed simulation rasters (.npz) are persisted
RUNS_BASE_DIR=data/processed/api_runs

# C++ SWE Solver executable path override (leave blank to use auto-discovery in build/)
SOLVER_PATH=

# Simulation grid parameters
GRID_SIZE=256
RESOLUTION_M=10.0

# --- Frontend Configuration ---
# API base URL for Vite frontend (leave blank to proxy to relative /api or localhost:8000)
VITE_API_URL=http://localhost:8000
